# Frontend Configuration
# Local development default:
NEXT_PUBLIC_API_URL=http://localhost:4040
# Production (Vercel): NEXT_PUBLIC_API_URL=https://api-hackerscolony.onrender.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): NEXT_PUBLIC_SITE_URL=https://hackerscolony.vercel.app

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret for signing anonymous view cookies; never use NEXT_PUBLIC_*.
ANONYMOUS_VIEW_COOKIE_SECRET=
# Server-only Supabase service-role key for anonymous view recording; never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Analytics (Phase 2+)
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_UMAMI_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_COMMENTS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Content source: keep true (mock) until real posts exist in the database,
# then set to false to serve pages from the Express content API.
# Production must remain false (live mode).
NEXT_PUBLIC_USE_MOCK_DATA=true
