# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4040
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Analytics (Phase 2+)
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_UMAMI_ID=

# Feature Flags
NEXT_PUBLIC_ENABLE_COMMENTS=false
NEXT_PUBLIC_ENABLE_ANALYTICS=false
# Content source: keep true (mock) until real posts exist in the database,
# then set to false to serve pages from the Express content API.
NEXT_PUBLIC_USE_MOCK_DATA=true