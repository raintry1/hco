# API Server Configuration
# Render injects PORT automatically — leave unset there. Local dev fallback: 4040.
PORT=4040
NODE_ENV=development
# Production (Render): NODE_ENV=production

# Frontend origin(s) allowed by CORS (comma-separated via CORS_ORIGINS).
# Localhost dev origins are always allowed. Production (Render):
# FRONTEND_URL=https://hackerscolony.vercel.app
FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# JWT (Phase 2+)
# JWT_SECRET
